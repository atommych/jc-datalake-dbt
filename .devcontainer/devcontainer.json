{
  "name": "data-landscape-dbt",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerEnv": {
    "DBT_PROFILES_DIR": "/workspaces/${localWorkspaceFolderBasename}/data_landscape"
  },
  "postCreateCommand": "pip install dbt-core dbt-duckdb openpyxl && cd data_landscape && dbt parse",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "dbt docs" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "innoverio.vscode-dbt-power-user",
        "redhat.vscode-yaml",
        "ms-python.python"
      ],
      "settings": {
        "files.associations": { "*.sql": "jinja-sql" }
      }
    }
  }
}
